# A execução real não existe nesta versão. Qualquer outro valor impede inicialização.
LIVE_TRADING_ENABLED=false
# O backend e worker usam o mesmo banco. Se necessário, defina caminho absoluto.
# CRYPTOLAB_DATABASE=C:/caminho/privado/cryptolab.sqlite3
STALE_AFTER_SECONDS=90
POLL_SECONDS=15
# Variável de servidor Next.js, nunca NEXT_PUBLIC_. Default já é loopback.
BACKEND_URL=http://127.0.0.1:8000
